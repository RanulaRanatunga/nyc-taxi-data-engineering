    {
      "type": "timeseries",
      "id": 21,
      "title": "Latency p50 / p95 / p99",
      "description": "End-to-end = producer send -> database commit (wall clock)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 35
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(streaming_end_to_end_latency_seconds_bucket[1m])))",
          "legendFormat": "end-to-end p50"
