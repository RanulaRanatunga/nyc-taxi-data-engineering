LOG_FORMAT=json
ALERT_WEBHOOK_URL=

DB_ENGINE=postgres
DB_ALLOW_DUCKDB_FALLBACK=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nyc_taxi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DUCKDB_PATH=data/nyc_taxi.duckdb

KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9094,localhost:9096
KAFKA_TOPIC=taxi-trips-stream
KAFKA_DLQ_TOPIC=taxi-trips-dlq
KAFKA_CONSUMER_GROUP=taxi-stream-analytics-group
KAFKA_TOPIC_PARTITIONS=6

STREAM_DB_ENGINE=postgres
STREAM_DB_ALLOW_DUCKDB_FALLBACK=true
STREAM_POSTGRES_HOST=localhost
STREAM_POSTGRES_PORT=5433
STREAM_POSTGRES_DB=nyc_taxi_streaming
STREAM_POSTGRES_USER=postgres
STREAM_POSTGRES_PASSWORD=postgres
STREAM_DUCKDB_PATH=data/nyc_taxi_streaming.duckdb

STREAM_EVENTS_PER_SECOND=25
STREAM_WINDOW_SIZE_MINUTES=5
STREAM_SLIDE_STEP_MINUTES=1
STREAM_WATERMARK_LATENESS_MINUTES=2
STREAM_MAX_FUTURE_SKEW_MINUTES=60
STREAM_POLL_MAX_RECORDS=200
STREAM_POLL_MIN_RECORDS=10
STREAM_BACKPRESSURE_LATENCY_SEC=1.0
STREAM_BACKPRESSURE_PAUSE_SEC=2.0

CONSUMER_METRICS_PORT=8000
PRODUCER_METRICS_PORT=8001
