# ==============================================================================
# NYC Taxi Data Engineering Environment Configuration
# ==============================================================================

# Database Engine Selection: 'postgres' or 'duckdb'
DB_ENGINE=duckdb

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nyc_taxi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SCHEMA=public

# DuckDB Configuration (Embedded local OLAP file)
DUCKDB_PATH=data/nyc_taxi.duckdb

# Kafka Configuration (Assignment 2)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9094
KAFKA_TOPIC=taxi-trips-stream
KAFKA_CONSUMER_GROUP=taxi-stream-analytics-group

# Streaming Simulation Parameters
STREAM_EVENTS_PER_SECOND=25
STREAM_WINDOW_SIZE_MINUTES=5
STREAM_SLIDE_STEP_MINUTES=1
STREAM_WATERMARK_LATENESS_MINUTES=2

# Observability Ports
PROMETHEUS_METRICS_PORT=8000
GRAFANA_PORT=3000
